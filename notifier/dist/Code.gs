// ---- the journey
const ORDER = ["malmo","ystad","lund","helsingborg","goteborg","jonkoping","linkoping","norrkoping","orebro","vasteras","uppsala","stockholm","gavle","sundsvall","ostersund","umea","lulea","jokkmokk","gallivare","kiruna"];
const CITY = {"malmo":"Malmö","ystad":"Ystad","lund":"Lund","helsingborg":"Helsingborg","goteborg":"Göteborg","jonkoping":"Jönköping","linkoping":"Linköping","norrkoping":"Norrköping","orebro":"Örebro","vasteras":"Västerås","uppsala":"Uppsala","stockholm":"Stockholm","gavle":"Gävle","sundsvall":"Sundsvall","ostersund":"Östersund","umea":"Umeå","lulea":"Luleå","jokkmokk":"Jokkmokk","gallivare":"Gällivare","kiruna":"Kiruna"};

const SURRA = {
  project: "surra-abf91",
  contact: "https://ronaksingh0075.github.io/surra/",
  // VAPID subject: how push services can reach the sender
  tz: "Europe/Stockholm",
  // when a player's time zone is unknown
  quiet: [22, 8],
  // alerts that arrive between 22:00 and 08:00 local time wait until morning
  expireMs: 48 * 36e5,
  // challenges expire after two days
  warnMs: 6 * 36e5,
  // "about six hours left" warning
  staleMs: 30 * 24 * 36e5,
  // players not seen for 30 days leave the roster
  fullScanMs: 6 * 36e5,
  // re-read the whole map this often (incremental reads in between)
  range: 2,
  // rivals: players up to two cities apart
  pushHosts: [/(^|\.)fcm\.googleapis\.com$/, /(^|\.)android\.googleapis\.com$/, /(^|\.)push\.services\.mozilla\.com$/, /(^|\.)push\.apple\.com$/, /(^|\.)notify\.windows\.com$/]
};
const NOTIFIER_VERSION = "1.0.0";
const DEFAULT_PREFS = { duels: true, streak: false, rivals: false };
function doGet() {
  const key = PropertiesService.getScriptProperties().getProperty("VAPID_PUBLIC");
  return ContentService.createTextOutput(JSON.stringify({ ok: true, app: "surra-notifier", version: NOTIFIER_VERSION, vapid: key || null })).setMimeType(ContentService.MimeType.JSON);
}
function doPost(e) {
  let body = {};
  try {
    body = JSON.parse(e && e.postData && e.postData.contents || "{}");
  } catch (err) {
    return reply("bad request");
  }
  const t = String(body.t || ""), id = String(body.id || "");
  if (!/^(new|res|ref)$/.test(t) || !/^[A-Za-z0-9_-]{6,64}$/.test(id)) return reply("bad request");
  const cache = CacheService.getScriptCache(), key = "ping:" + t + ":" + id;
  if (cache.get(key)) return reply("duplicate");
  cache.put(key, "1", 120);
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(15e3)) return reply("busy");
  try {
    const st = loadState();
    const r = t === "new" ? onNewChallenge(FS.get("challenges/" + id), st) : t === "res" ? onResult(FS.get("challenges/" + id), st) : onInvite(id, st);
    if (st.dirty) saveState(st);
    return reply(r);
  } catch (err) {
    console.error("doPost " + t + " " + id + ": " + (err && err.stack || err));
    return reply("error");
  } finally {
    lock.releaseLock();
  }
}
function tick() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(3e4)) return;
  try {
    const st = loadState(), now = Date.now(), since = new Date((st.tick || now - 36e5) - 12e4);
    st.tick = now;
    safe("new", () => FS.query(select("challenges", where("created", ">", since), { limit: 300 })).forEach((c) => {
      if (c.status === "pending" && !c.pushTo) safe("new " + c._id, () => onNewChallenge(c, st));
    }));
    safe("res", () => FS.query(select("challenges", where("resolvedAt", ">", since), { limit: 300 })).forEach((c) => {
      if (c.status !== "pending" && !c.pushRes) safe("res " + c._id, () => onResult(c, st));
    }));
    safe("held", () => sendHeld(st, now));
    safe("map", () => scanPlayers(st, now));
    const hour = Utilities.formatDate(new Date(now), "UTC", "yyyy-MM-dd HH");
    if (st.hour !== hour) {
      st.hour = hour;
      safe("expiring", () => warnExpiring(st, now));
      safe("reminders", () => remindPractice(st, now));
      prune(st, now);
    }
    saveState(st);
  } finally {
    lock.releaseLock();
  }
}
function onNewChallenge(c, st) {
  if (!c || c.status !== "pending" || c.pushTo) return "skip";
  if (Date.now() - (c.created || 0) > SURRA.expireMs) return "expired";
  markChallenge(c._id, { pushTo: Date.now() });
  const n = FS.get("notify/" + c.to);
  if (!wants(n, "duels")) return "off";
  const left = (c.created + SURRA.expireMs - Date.now()) / 1e3;
  return deliver(st, c.to, n, msgChallenge(c), { ttl: left, urgency: "high" }, "duels");
}
function onResult(c, st) {
  if (!c || c.status === "pending" || c.pushRes) return "skip";
  markChallenge(c._id, { pushRes: Date.now() });
  if (c.fromSeen) return "seen";
  const n = FS.get("notify/" + c.from);
  if (!wants(n, "duels")) return "off";
  return deliver(st, c.from, n, msgResult(c), { ttl: 72 * 3600 }, "duels");
}
function onInvite(uid, st) {
  if (st.ref[uid]) return "done";
  const n = FS.get("notify/" + uid);
  if (!n || !n.ref || n.ref === uid) return "skip";
  st.ref[uid] = Date.now();
  st.dirty = true;
  const inviter = FS.get("notify/" + n.ref);
  if (!wants(inviter, "duels")) return "off";
  return deliver(st, n.ref, inviter, msgInvite(n.name), { ttl: 72 * 3600 }, "duels");
}
function warnExpiring(st, now) {
  const to = new Date(now - SURRA.expireMs + SURRA.warnMs), from = new Date(to.getTime() - 2 * 36e5);
  FS.query(select("challenges", and(where("created", ">=", from), where("created", "<", to)), { limit: 300 })).forEach((c) => safe("warn " + c._id, () => {
    if (c.status !== "pending" || c.pushExp) return;
    markChallenge(c._id, { pushExp: Date.now() });
    const n = FS.get("notify/" + c.to);
    if (!wants(n, "duels") || isQuiet(n.tz, now)) return;
    pushTo(c.to, n, msgExpiring(c), { ttl: 5 * 3600 });
  }));
}
function remindPractice(st, now) {
  const slot = new Date(now).getUTCHours();
  FS.query(select("notify", and(where("slot", "==", slot), where("push.streak", "==", true)), { limit: 2e3 })).forEach((n) => safe("remind " + n._id, () => {
    if (!wants(n, "streak") || !n.day) return;
    const uid = n._id, tz = n.tz || SURRA.tz, today = localDay(tz, now);
    if (n.day >= today || st.streak[uid] === today) return;
    const off = Math.round((Date.parse(today) - Date.parse(n.day)) / 864e5);
    if (!(off >= 1 && off <= 7)) return;
    st.streak[uid] = today;
    const alive = off === 1 && n.streak > 0;
    pushTo(uid, n, msgReminder(n, alive), { ttl: Math.max(1800, hoursToMidnight(tz, now) * 3600), topic: "practice" });
  }));
}
function scanPlayers(st, now) {
  const full = !st.scan || now - (st.full || 0) > SURRA.fullScanMs;
  const docs = full ? FS.query(select("players", null, { limit: 5e3 })) : FS.query(select("players", where("updatedAt", ">", new Date(st.scan - 12e4)), { limit: 1e3 }));
  const before = st.pos, pos = full ? {} : Object.assign({}, before), events = [];
  docs.forEach((p) => {
    const idx = ORDER.indexOf(p.stop), seen = Number(p.updatedAt) || 0;
    if (idx < 0 || now - seen > SURRA.staleMs) {
      delete pos[p._id];
      return;
    }
    const prev = before[p._id];
    pos[p._id] = [idx, String(p.name || "Traveller").slice(0, 24), String(p.avatar || "bee").slice(0, 16), String(p.color || "fjord").slice(0, 16), Number(p.xp) || 0, seen];
    if (!st.booted) return;
    if (!prev) {
      if (seen > (st.scan || 0) - 12e4) events.push({ kind: "near", who: p._id, idx });
    } else if (idx > prev[0]) events.push({ kind: "pass", who: p._id, from: prev[0], idx });
  });
  if (full) {
    Object.keys(pos).forEach((uid) => {
      if (now - pos[uid][5] > SURRA.staleMs) delete pos[uid];
    });
    st.full = now;
  }
  const flat = (m) => Object.keys(m).sort().map((u) => u + ":" + m[u].join("|")).join(";");
  const changed = flat(pos) !== flat(before);
  st.pos = pos;
  st.scan = now;
  st.booted = true;
  if (changed || now - (st.rosterAt || 0) > 2 * 36e5) {
    writeRoster(pos, now);
    st.rosterAt = now;
  }
  if (events.length) rivalAlerts(st, events, now);
}
function writeRoster(pos, now) {
  const list = Object.keys(pos).map((uid) => {
    const p = pos[uid];
    return { u: uid, n: p[1], a: p[2], c: p[3], s: ORDER[p[0]], x: p[4], t: p[5] };
  });
  FS.patch("shared/roster", { at: now, list });
  const counts = {};
  let active = 0;
  list.forEach((r) => {
    counts[r.s] = (counts[r.s] || 0) + 1;
    if (now - r.t < 7 * 864e5) active++;
  });
  FS.patch("public/map", { at: now, counts, total: list.length, active });
}
function rivalAlerts(st, events, now) {
  const pos = st.pos, targets = {};
  events.forEach((ev) => {
    const who = pos[ev.who];
    if (!who) return;
    Object.keys(pos).forEach((uid) => {
      if (uid === ev.who || targets[uid]) return;
