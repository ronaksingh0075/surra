{
  "name": "surra",
  "private": true,
  "version": "1.10.0",
  "description": "Surra: Swedish conversation practice from A1 to C1, as an installable web app.",
  "scripts": {
    "validate": "node tools/validate.js",
    "build": "node tools/validate.js && node tools/build.js && node tools/build-notifier.js",
    "notifier": "node tools/build-notifier.js",
    "map": "node tools/mapgen.js",
    "release": "npm run build && node tools/release-check.js"
  },
  "devDependencies": {
    "@fontsource-variable/nunito": "^5.1.0",
    "@fontsource/caprasimo": "^5.1.0",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "esbuild": "^0.28.2",
    "firebase": "^11.0.0",
    "htm": "3.1.1",
    "sane-topojson": "^4.0.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
